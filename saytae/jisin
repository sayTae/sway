curl -s "https://api.p2pquake.net/v2/history?codes=551&limit=40" | jq -r "sort_by(.earthquake.time) | unique_by(.earthquake.time)[] | select(.earthquake.maxScale >= 30) | .earthquake as \$e | ((\$e.hypocenter.name | if . == \"\" then \"確認中\" else . end) + \"・・・・・\")[:5] as \$loc | (\$e.hypocenter.magnitude | if . == -1 then \"確認中\" else tostring end) as \$mag | \"[\(\$e.time)] \(\$loc) | 震度: \(\$e.maxScale / 10) | M\(\$mag)\""
