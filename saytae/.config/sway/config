# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# Set font
font pango: Hiragino Kaku Gothic Pro 11

# display gap
gaps inner 0
gaps outer 0

# Set border
default_border pixel 2

# Keyboard
input "type:keyboard" {
    xkb_model jp106
    xkb_layout jp
	xkb_options ctrl:swapcaps
	repeat_delay 180
	repeat_rate 50
}

# Mouse
input "type:touchpad" {
	dwt enabled
	tap enabled
	natural_scroll enabled
    middle_emulation enabled
	scroll_method edge
	accel_profile flat
	pointer_accel 1
}

# Henkan
bindsym --no-repeat Henkan exec busctl --user \
call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 SetCurrentIM s "mozc"

# Muhenkan
bindsym --no-repeat Muhenkan exec busctl --user \
call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 SetCurrentIM s "keyboard-jp"

# Hiragana_Katakana
bindsym --no-repeat Hiragana_Katakana exec busctl --user \
call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 SetCurrentIM s "hangul"

### Variables

# Mod key
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened

# Terminal server
exec foot --server

# Terminal emulator
set $term footclient

#exec term
exec $term

#login
exec $screenlock

# Terminal
# for_window [app_id="scratch_term"] floating enable, resize set 70 ppt 70 ppt, move position center, move scratchpad
# exec sh -c "foot --server & until $term -a scratch_term; do :; done"

# Web browser
set $browser firefox

# Application munu
# set $menu wofi --show
# set $menu pkill wofi || wofi --show drun
set $menu killall wofi || wofi --show drun

# fcitx5
exec --no-startup-id fcitx5 -d

# Notification
exec mako

# oritatami=lock
# Take a screenshot & copy (drag)
set $screencopy grim -g "$(slurp)" - | wl-copy 
set $screenshot grim -g "$(slurp)" - | swappy -f -

### Floating App
# imv
for_window [app_id="imv"] floating enable
# mpv
for_window [app_id="mpv"] resize set height 542 px
# for_window [app_id="mpv"] resize set height 32 ppt
# fcitx5
for_window [app_id="org.fcitx.fcitx5-config-qt"] floating enable
# pulseaudio
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
# blueman
for_window [app_id="blueman-manager"] floating enable
# nautilus
for_window [app_id="pcmanfm"] floating enable
# anki
for_window [app_id="anki"] floating enable
# foot
# for_window [app_id="foot"] floating enable

### Output configuration
exec kanshi

# Startup workspace
exec swaymsg workspace '壱'

# focused
client.focused #FFFFFF #FFFFFF #000000 #FF4500

# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
#
# Set wallpaper
set $wall0 /usr/share/backgrounds/downloads/uchuu.jpg
set $wall1 /usr/share/backgrounds/downloads/jihanki.jpg
set $wall2 /usr/share/backgrounds/downloads/windowLinux.jpg
set $wall3 #1B2A4A

# Wallpaper mode
bindsym $mod+Shift+w mode "wallpaper"

mode "wallpaper" {
     bindsym 1 output * bg $wall1 fill; mode "default"
     bindsym 2 output * bg $wall2 fill; mode "default"
     bindsym 3 output * bg $wall3 solid_color; mode "default"
     
     # Escape mode
     bindsym Escape mode "default"
     bindsym Return mode "default"
}

output * bg $wall1 fill
# output HDMI-A-1 bg $wall5 solid_color

# Screen lock (waylock)
set $screenlock swaylock -c "1B2A4A"
# set $screenlock swaylock --image $wall0

### Idle configuration
#
bindswitch --locked lid:on \
	exec playerctl -a pause; exec pactl set-sink-mute @DEFAULT_SINK@ 1; exec $screenlock

bindswitch --locked lid:off \
	exec pactl set-sink-mute @DEFAULT_SINK@ 0

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.


### Key bindings
#
    # Start a terminal
    bindsym $mod+Return exec $term

	# Web browser
    bindsym $mod+q exec $browser

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym --no-repeat Menu exec $menu

	# Take a screen
	bindsym $mod+Shift+a exec $screenshot
	bindsym $mod+Shift+s exec $screencopy
	bindsym Print exec $screencopy
	bindsym Shift+Print exec $screenshot

	# Screen locked
	# Bindsym $mod+Backspace exec $screenlock
	bindsym $mod+Escape exec $screenlock

	# Set volume
	bindsym $mod+Asciicircum exec pactl set-sink-volume @DEFAULT_SINK@ +1%
	bindsym $mod+Minus exec pactl set-sink-volume @DEFAULT_SINK@ -1%
	bindsym $mod+Backslash exec pactl set-sink-mute @DEFAULT_SINK@ toggle
	bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1%
	bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1%
	bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

	# Set Monitor brightness
	bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 10%+
	bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

	# Start sceen lock
	# bindsym $mod+m swaylock --color 000000

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
	# Workspace setting
	workspace '壱' output HDMI-A-1
	workspace '弐' output HDMI-A-1
	workspace '参' output HDMI-A-1
	workspace '四' output HDMI-A-1
	workspace '五' output HDMI-A-1
	workspace '六' output HDMI-A-1
	workspace '七' output HDMI-A-1
	workspace '八' output HDMI-A-1
	workspace '九' output HDMI-A-1
	workspace '拾' output HDMI-A-1

	# Switch to workspace
	bindsym $mod+1 workspace '壱'
	bindsym $mod+2 workspace '弐'
	bindsym $mod+3 workspace '参'
	bindsym $mod+4 workspace '四'
	bindsym $mod+5 workspace '五'
	bindsym $mod+6 workspace '六'
	bindsym $mod+7 workspace '七'
	bindsym $mod+8 workspace '八'
	bindsym $mod+9 workspace '九'
	bindsym $mod+0 workspace '拾'

	# Move focused container to workspace
	bindsym $mod+Shift+1 move container to workspace '壱'
	bindsym $mod+Shift+2 move container to workspace '弐'
	bindsym $mod+Shift+3 move container to workspace '参'
	bindsym $mod+Shift+4 move container to workspace '四'
	bindsym $mod+Shift+5 move container to workspace '五'
	bindsym $mod+Shift+6 move container to workspace '六'
	bindsym $mod+Shift+7 move container to workspace '七'
	bindsym $mod+Shift+8 move container to workspace '八'
	bindsym $mod+Shift+9 move container to workspace '九'
	bindsym $mod+Shift+0 move container to workspace '拾'

    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+a focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+space focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+Backspace move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+Backspace scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $right resize shrink width 10px
    bindsym $up resize grow height 10px
    bindsym $down resize shrink height 10px
    bindsym $left resize grow width 10px

    # Ditto, with arrow keys
    bindsym Right resize shrink width 10px
    bindsym Up resize grow height 10px
    bindsym Down resize shrink height 10px
    bindsym Left resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# bar {
#     position top

bar {
    position top
	status_command i3status-rs
	font pango: Hiragino Kaku Gothic Pro 11
    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    # status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*
